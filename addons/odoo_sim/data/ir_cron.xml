<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Both crons are driven by triggers: the settle cron at each run's end and
    each shipment's arrival, the vendor agent whenever an order is approved.
    The intervals are a safety net only, and are game hours like every cron
    interval in a world (DESIGN.md 4.3).
-->

<record id="ir_cron_world_settle" model="ir.cron" forcecreate="True">
    <field name="name">Game world: settle due events</field>
    <field name="model_id" ref="model_game_world"/>
    <field name="state">code</field>
    <field name="code">model._cron_settle()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
</record>

<record id="ir_cron_vendor_agent" model="ir.cron" forcecreate="True">
    <field name="name">Game world: vendors ship their orders</field>
    <field name="model_id" ref="model_game_vendor"/>
    <field name="state">code</field>
    <field name="code">model._cron_process_orders()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
</record>

</odoo>
