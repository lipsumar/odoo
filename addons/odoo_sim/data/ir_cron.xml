<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Every cron here is driven by triggers: the settle cron at each run's end,
    each shipment's arrival and each payment's due time; the vendor agent
    whenever an order is approved; the customers when an invoice is posted and
    when they are due to order again; the bank feed at every transaction on a
    connected account; the post office whenever an email is posted (MAIL.md).
    The intervals are a safety net only, and are game hours like every cron
    interval in a world (DESIGN.md 4.3).
-->

<record id="ir_cron_world_settle" model="ir.cron" forcecreate="True">
    <field name="name">Game world: settle due events</field>
    <field name="model_id" ref="model_game_world"/>
    <field name="state">code</field>
    <field name="code">model._cron_settle()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
</record>

<record id="ir_cron_vendor_agent" model="ir.cron" forcecreate="True">
    <field name="name">Game world: vendors ship their orders</field>
    <field name="model_id" ref="model_game_vendor"/>
    <field name="state">code</field>
    <field name="code">model._cron_process_orders()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
</record>

<!-- As root, like Odoo's own fetchmail cron: the gateway runs as whoever hands it the mail. -->
<record id="ir_cron_post_office" model="ir.cron" forcecreate="True">
    <field name="name">Game world: deliver the post</field>
    <field name="model_id" ref="model_game_email_delivery"/>
    <field name="state">code</field>
    <field name="code">model._cron_deliver()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
</record>

<record id="ir_cron_customer_orders" model="ir.cron" forcecreate="True">
    <field name="name">Game world: customers place orders</field>
    <field name="model_id" ref="model_game_customer"/>
    <field name="state">code</field>
    <field name="code">model._cron_place_orders()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
</record>

<record id="ir_cron_customer_invoices" model="ir.cron" forcecreate="True">
    <field name="name">Game world: customers read their invoices</field>
    <field name="model_id" ref="model_game_customer"/>
    <field name="state">code</field>
    <field name="code">model._cron_read_invoices()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
</record>

<record id="ir_cron_bank_feed" model="ir.cron" forcecreate="True">
    <field name="name">Game bank: import transactions into Odoo</field>
    <field name="model_id" ref="account.model_account_bank_statement_line"/>
    <field name="state">code</field>
    <field name="code">model._cron_game_bank_feed()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
</record>

</odoo>
