<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    A window onto the world for whoever is developing the game: Settings >
    Technical > Game World, in debug mode, for administrators, read-only,
    the game bank included.
    Nobody has write access to these models; the game writes them through
    sudo() from its own endpoints and crons (GAME_STATE.md 11).
-->

<record id="game_stock_view_list" model="ir.ui.view">
    <field name="model">game.stock</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="product_id"/>
            <field name="qty"/>
            <field name="uom_id"/>
            <field name="write_date" string="Last change (game)"/>
        </list>
    </field>
</record>

<record id="game_stock_entry_view_list" model="ir.ui.view">
    <field name="model">game.stock.entry</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="date"/>
            <field name="kind"/>
            <field name="product_id"/>
            <field name="qty"/>
            <field name="uom_id"/>
            <field name="production_id"/>
            <field name="shipment_id"/>
            <field name="customer_order_id"/>
        </list>
    </field>
</record>

<record id="game_production_view_list" model="ir.ui.view">
    <field name="model">game.production</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="workstation_id"/>
            <field name="product_id"/>
            <field name="qty"/>
            <field name="state"/>
            <field name="date_start"/>
            <field name="date_end"/>
            <field name="production_id"/>
        </list>
    </field>
</record>

<record id="game_shipment_view_list" model="ir.ui.view">
    <field name="model">game.shipment</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="vendor_id"/>
            <field name="purchase_id"/>
            <field name="state"/>
            <field name="date_shipped"/>
            <field name="date_arrival"/>
            <field name="date_accepted"/>
        </list>
    </field>
</record>

<record id="game_recipe_view_list" model="ir.ui.view">
    <field name="model">game.recipe</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="product_id"/>
            <field name="duration"/>
            <field name="line_ids" widget="many2many_tags"/>
        </list>
    </field>
</record>

<record id="game_bank_account_view_list" model="ir.ui.view">
    <field name="model">game.bank.account</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="number"/>
            <field name="partner_id"/>
            <field name="balance"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="journal_id"/>
        </list>
    </field>
</record>

<record id="game_bank_transaction_view_list" model="ir.ui.view">
    <field name="model">game.bank.transaction</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="date"/>
            <field name="kind"/>
            <field name="payer_id"/>
            <field name="payee_id"/>
            <field name="amount"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="reference"/>
        </list>
    </field>
</record>

<record id="game_customer_view_list" model="ir.ui.view">
    <field name="model">game.customer</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="partner_id"/>
            <field name="product_id"/>
            <field name="qty"/>
            <field name="max_price"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="payment_delay"/>
            <field name="interval"/>
            <field name="write_to"/>
            <field name="next_order_date"/>
        </list>
    </field>
</record>

<record id="game_customer_order_view_list" model="ir.ui.view">
    <field name="model">game.customer.order</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="date_requested"/>
            <field name="customer_id"/>
            <field name="product_id"/>
            <field name="qty"/>
            <field name="state"/>
            <field name="qty_paid"/>
            <field name="amount_paid"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="date_paid"/>
            <field name="date_delivered"/>
        </list>
    </field>
</record>

<record id="game_customer_invoice_view_list" model="ir.ui.view">
    <field name="model">game.customer.invoice</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="date_received"/>
            <field name="customer_id"/>
            <field name="name"/>
            <field name="invoice_id"/>
            <field name="qty"/>
            <field name="amount"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="state"/>
            <field name="reason"/>
            <field name="date_due"/>
            <field name="transaction_id"/>
        </list>
    </field>
</record>

<record id="game_stock_action" model="ir.actions.act_window">
    <field name="name">On hand</field>
    <field name="res_model">game.stock</field>
</record>
<record id="game_stock_entry_action" model="ir.actions.act_window">
    <field name="name">Ledger</field>
    <field name="res_model">game.stock.entry</field>
</record>
<record id="game_production_action" model="ir.actions.act_window">
    <field name="name">Production runs</field>
    <field name="res_model">game.production</field>
</record>
<record id="game_shipment_action" model="ir.actions.act_window">
    <field name="name">Shipments</field>
    <field name="res_model">game.shipment</field>
</record>
<record id="game_recipe_action" model="ir.actions.act_window">
    <field name="name">Recipes</field>
    <field name="res_model">game.recipe</field>
</record>
<record id="game_workstation_action" model="ir.actions.act_window">
    <field name="name">Workstations</field>
    <field name="res_model">game.workstation</field>
</record>
<record id="game_vendor_action" model="ir.actions.act_window">
    <field name="name">Vendors</field>
    <field name="res_model">game.vendor</field>
</record>

<record id="game_email_view_list" model="ir.ui.view">
    <field name="model">game.email</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="date"/>
            <field name="origin"/>
            <field name="email_from"/>
            <field name="email_to"/>
            <field name="subject"/>
            <field name="preview" optional="hide"/>
            <field name="res_model" optional="hide"/>
            <field name="res_id" optional="hide"/>
        </list>
    </field>
</record>

<record id="game_email_delivery_view_list" model="ir.ui.view">
    <field name="model">game.email.delivery</field>
    <field name="arch" type="xml">
        <list create="0" edit="0" delete="0">
            <field name="date"/>
            <field name="email_id"/>
            <field name="address"/>
            <field name="route"/>
            <field name="user_id"/>
            <field name="state"/>
            <field name="is_read" optional="hide"/>
            <field name="failure"/>
        </list>
    </field>
</record>

<record id="game_email_action" model="ir.actions.act_window">
    <field name="name">Post</field>
    <field name="res_model">game.email</field>
</record>
<record id="game_email_delivery_action" model="ir.actions.act_window">
    <field name="name">Deliveries</field>
    <field name="res_model">game.email.delivery</field>
</record>
<record id="game_bank_account_action" model="ir.actions.act_window">
    <field name="name">Bank accounts</field>
    <field name="res_model">game.bank.account</field>
</record>
<record id="game_bank_transaction_action" model="ir.actions.act_window">
    <field name="name">Bank transactions</field>
    <field name="res_model">game.bank.transaction</field>
</record>
<record id="game_customer_action" model="ir.actions.act_window">
    <field name="name">Customers</field>
    <field name="res_model">game.customer</field>
</record>
<record id="game_customer_order_action" model="ir.actions.act_window">
    <field name="name">Customer orders</field>
    <field name="res_model">game.customer.order</field>
</record>
<record id="game_customer_invoice_action" model="ir.actions.act_window">
    <field name="name">Invoices received</field>
    <field name="res_model">game.customer.invoice</field>
</record>

<menuitem id="menu_game_world" name="Game World" parent="base.menu_custom" sequence="200">
    <menuitem id="menu_game_stock" action="game_stock_action" sequence="10"/>
    <menuitem id="menu_game_stock_entry" action="game_stock_entry_action" sequence="20"/>
    <menuitem id="menu_game_production" action="game_production_action" sequence="30"/>
    <menuitem id="menu_game_shipment" action="game_shipment_action" sequence="40"/>
    <menuitem id="menu_game_recipe" action="game_recipe_action" sequence="50"/>
    <menuitem id="menu_game_workstation" action="game_workstation_action" sequence="60"/>
    <menuitem id="menu_game_vendor" action="game_vendor_action" sequence="70"/>
    <menuitem id="menu_game_bank_account" action="game_bank_account_action" sequence="80"/>
    <menuitem id="menu_game_bank_transaction" action="game_bank_transaction_action" sequence="90"/>
    <menuitem id="menu_game_customer" action="game_customer_action" sequence="100"/>
    <menuitem id="menu_game_customer_order" action="game_customer_order_action" sequence="110"/>
    <menuitem id="menu_game_customer_invoice" action="game_customer_invoice_action" sequence="120"/>
    <menuitem id="menu_game_email" action="game_email_action" sequence="130"/>
    <menuitem id="menu_game_email_delivery" action="game_email_delivery_action" sequence="140"/>
</menuitem>

</odoo>
